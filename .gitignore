__pycache__/
*.pyc

# Knowledge sources stay local: publisher copyright, and the datasets are
# many GB. Only the catalog, the registry and the READMEs go into git; the
# manifest lists where to download everything else.
data/knowledge/sources/**
!data/knowledge/sources/**/
!data/knowledge/sources/README.md
!data/knowledge/sources/catalog.json
!data/knowledge/sources/00_registry/sources_manifest.csv
!data/knowledge/sources/00_registry/fetch_figshare_data.py
!data/knowledge/sources/00_registry/*.md

# Generated from the source documents by ingestion
data/knowledge/vector_store/
data/knowledge/extracted/

# Generated by the review page: decisions made on this machine (the trial's
# log, and data/records/review_log.test.jsonl with the earlier test lines)
data/records/review_log*.jsonl

# Generated by intake: one file per case entered on this machine
data/records/cases/

# Generated by the search page: every search, mark and source suggestion on this machine
data/records/search_log.jsonl

# Generated by case-based learning: attempts, teaching-case analyses and the learning log on this machine
data/records/learning/
# The patient record on this machine: each person's lines and the access trail (fake data only)
data/records/people/
data/records/access_log.jsonl

# Built from the review log by python -m quality.trial_report (trial results)
data/quality/trial/report.csv
